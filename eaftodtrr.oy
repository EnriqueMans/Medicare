# ---------------------------------------------------------------------------
# EAF -> DTRR field mapping
# Best-effort mapping based on field name/description matching between the
# EAF layout (222 fields) and the DTRR fixed-width layout (107 named fields).
# These are two independently defined specs, not an official CMS crosswalk —
# verify against your source docs before relying on this in production.
#
# Fields with no reasonable EAF counterpart are set to None (mostly CARA/
# opioid edit fields, IC model fields, system timestamps, and CMS-internal
# fillers that only exist on the CMS reply side).
# ---------------------------------------------------------------------------

dtrr['beneficiary_id']                          = eaf['mbi']                          # Field 20: Member MBI*
dtrr['surname']                                  = eaf['member_last_name']             # Field 9
dtrr['first_name']                               = eaf['member_first_name']            # Field 7
dtrr['middle_initial']                           = eaf['member_middle_initial']        # Field 8
dtrr['sex_code']                                 = eaf['member_gender']                # Field 11
dtrr['date_of_birth']                            = eaf['member_birth_date']            # Field 10
dtrr['record_type']                              = None                                # DTRR-side only (reply record marker)
dtrr['contract_number']                          = eaf['contract_id']                  # Field 3
dtrr['state_code']                               = eaf['member_state']                 # Field 16
dtrr['county_code']                              = None                                # Not present on EAF
dtrr['disability_indicator']                     = None                                # Not present on EAF
dtrr['hospice_indicator']                        = None                                # Not present on EAF
dtrr['institutional_nhc_hcbs_indicator']         = None                                # Not present on EAF
dtrr['esrd_indicator']                           = eaf['esrd']                         # Field 50
dtrr['trc']                                      = None                                # CMS-generated reply code, not submitted
dtrr['tc']                                       = eaf['transaction_type']             # Field 74
dtrr['entitlement_type_code']                    = None                                # Not present on EAF
dtrr['effective_date']                           = eaf['effective_date']               # Field 73
dtrr['wa_indicator']                             = None                                # Not present on EAF
dtrr['pbp_id']                                   = eaf['pbp_id']                       # Field 4
dtrr['filler_75']                                = None
dtrr['transaction_date']                         = eaf['submit_date']                  # Field 2
dtrr['ui_initiated_change_flag']                 = None                                # System-generated
dtrr['item24_trc_dependent']                     = None                                # CMS reply-side only
dtrr['district_office_code']                     = None                                # Not present on EAF
dtrr['prev_part_d_contract_pbp']                 = None                                # Not present on EAF (history-derived)
dtrr['sep_reason_code']                          = eaf['sep_reason_code']              # Field 64
dtrr['filler_110']                               = None
dtrr['source_id']                                = eaf['sales_location']               # Field 80
dtrr['prior_pbp_id']                             = None                                # Not present on EAF
dtrr['application_date']                         = eaf['application_sign_date']        # Field 75
dtrr['ui_user_org_designation']                  = None                                # Not present on EAF
dtrr['out_of_area_flag']                         = None                                # Not present on EAF
dtrr['segment_number']                           = eaf['segment_id']                   # Field 5
dtrr['part_c_premium']                           = None                                # CMS-calculated, not submitted
dtrr['part_d_premium']                           = None                                # CMS-calculated, not submitted
dtrr['election_type_code']                       = eaf['election_type']                # Field 78
dtrr['enrollment_source_code']                   = eaf['sales_location']               # Field 80 (closest analog)
dtrr['part_d_opt_out_flag']                      = eaf['part_d_opt_out']               # Field 63
dtrr['premium_withhold_option']                  = eaf['premium_withhold']             # Field 144
dtrr['cumulative_uncovered_months']              = eaf['uncovered_months']             # Field 77
dtrr['creditable_coverage_flag']                 = eaf['creditable_coverage']           # Field 76
dtrr['employer_subsidy_override_flag']           = eaf['employer_subsidy']             # Field 90
dtrr['processing_timestamp']                     = None                                # System-generated
dtrr['end_date']                                 = eaf['span_end_date']                # Field 110
dtrr['submitted_uncovered_months']               = eaf['uncovered_months']             # Field 77 (same source as above)
dtrr['filler_189']                               = None
dtrr['preferred_language_other_than_english']    = eaf['language']                     # Field 49
dtrr['accessible_format']                        = eaf['accessibility_format']         # Field 174
