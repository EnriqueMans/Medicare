dtrr['system_assigned_transaction_tracking_id']  = eaf['unique_key']                   # Field 106
dtrr['plan_assigned_transaction_tracking_id']    = eaf['confirmation_number']          # Field 1
dtrr['relationship_agent']                       = eaf['relationship_to_enrollee']      # Field 189, value == 1
dtrr['relationship_broker']                      = eaf['relationship_to_enrollee']      # Field 189, value == 2
dtrr['relationship_ship_counselors']             = eaf['relationship_to_enrollee']      # Field 189, value == 3
